{
    "name": "superconductor/stdio",
    "description": "The stdio transport for Superconductor MCP.",
    "type": "library",
    "version": "0.11.0",
    "keywords": [
        "superconductor",
        "mcp",
        "stdio",
        "transport"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/docs/superconductor/stdio",
    "support": {
        "issues": "https://github.com/superconductor-mcp/stdio/issues",
        "source": "https://github.com/superconductor-mcp/stdio"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "superconductor/core": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/io-pools": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0",
        "venusian-voyager/signals": "^0.11.0",
        "venusian-voyager/sketches": "^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "venusian-voyager/config": "^0.11.0",
        "venusian/framework": "^0.11.0"
    },
    "autoload": {
        "psr-4": {
            "SuperconductorMCP\\STDIO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperconductorMCP\\STDIO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "SuperconductorMCP\\STDIO\\Providers\\STDIOServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
